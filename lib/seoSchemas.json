  "faq": {
    "shared": [
      {
        "question": "Wat is PayLTR?",
        "answer": "PayLTR is een zakelijk financieringsplatform voor Nederlands MKB. Je kunt bedrijfskosten vandaag betalen en later terugbetalen: tot 120 dagen betalingspauze, daarna 24 maanden met 0% rente op terugbetaling."
      },
      {
        "question": "Hoeveel kan ik lenen bij PayLTR?",
        "answer": "Je kunt zakelijke financiering aanvragen van €3.000 tot €500.000. Het goedgekeurde bedrag hangt af van de cashflow en financiële gezondheid van je bedrijf."
      },
      {
        "question": "Hoe werkt de 120-dagen betalingspauze?",
        "answer": "Na uitbetaling heb je tot 120 dagen zonder aflossing. Daarna betaal je in vaste maandtermijnen terug. Tijdens de pauze geldt een gebruiksvergoeding."
      },
      {
        "question": "Kan ik vervroegd aflossen?",
        "answer": "Ja. Vervroegd aflossen is altijd toegestaan zonder boete."
      }
    ]
  },
